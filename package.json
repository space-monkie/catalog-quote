{
  "name": "catalog-quote",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.mts",
    "test:watch": "vitest --config vitest.config.mts",
    "test:rules": "node scripts/firebase-cli.mjs emulators:exec --project demo-catalog-quote --only auth,firestore,storage \"vitest run --config vitest.emulator.config.mts\"",
    "emulators": "node scripts/firebase-cli.mjs emulators:start --project demo-catalog-quote --import=./emulator-data --export-on-exit",
    "emulators:fresh": "node scripts/firebase-cli.mjs emulators:start --project demo-catalog-quote",
    "seed": "tsx scripts/seed.ts",
    "dev:all": "node scripts/firebase-cli.mjs emulators:exec --project demo-catalog-quote --ui --import=./emulator-data --export-on-exit \"next dev\"",
    "deploy:rules": "node scripts/firebase-cli.mjs deploy --only firestore:rules,firestore:indexes,storage",
    "use:emulators": "cp .env.emulators .env.local && echo 'Now using the Firebase emulators (restart npm run dev)'",
    "use:firebase": "cp .env.firebase .env.local && echo 'Now using the real Firebase project (restart npm run dev)'"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "firebase": "^12.19.0",
    "firebase-admin": "^14.4.0",
    "lucide-react": "^1.47.0",
    "next": "16.3.6",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.13.6",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "firebase-tools": "^15.30.2",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "~4.0.18"
  }
}
