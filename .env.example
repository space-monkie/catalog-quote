# Copy to .env.local. These defaults run everything against the Firebase Emulator Suite
# with a demo project, so `npm run emulators` + `npm run seed` + `npm run dev` work as-is.

# ---- Firebase web app config (Project settings > General > Your apps) ----
# For a real project, replace with your web app's values.
NEXT_PUBLIC_FIREBASE_API_KEY=demo-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-catalog-quote.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-catalog-quote
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=demo-catalog-quote.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=000000000000
NEXT_PUBLIC_FIREBASE_APP_ID=1:000000000000:web:demo

# Public URL of the site, used for Open Graph tags and the /q/{id} links in messages.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Local development against the Firebase Emulator Suite ----
# Set NEXT_PUBLIC_USE_EMULATORS=false and remove the *_EMULATOR_HOST lines to talk to a real project.
NEXT_PUBLIC_USE_EMULATORS=true
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199

# ---- Server only (optional) ----
# JSON of a service account, for hosts without Application Default Credentials.
# On Firebase App Hosting leave this empty; the backend service account is used automatically.
FIREBASE_SERVICE_ACCOUNT_JSON=
